generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GESTAO
  PROFESSOR
}

enum TipoAula {
  AULA
  PLANTAO
  AULAO
}

enum TipoReuniao {
  REUNIAO
  SIMULADO
  AULAO
  AULA
}

model Reuniao {
  id            String      @id @default(cuid())
  titulo        String
  tipo          TipoReuniao
  data          DateTime    @db.Date
  horarioInicio DateTime    @db.Time(0)
  horarioFim    DateTime    @db.Time(0)
  local         String?
  descricao     String?
  criadoPorId   String?
  criadoPor     User?       @relation("CriadorReunioes", fields: [criadoPorId], references: [id], onDelete: SetNull)
  // Matéria da aula/aulão (obrigatória nesses tipos e imutável depois de criado o evento).
  disciplinaId  String?
  disciplina    Disciplina? @relation("EventoDisciplina", fields: [disciplinaId], references: [id])
  // A gestão marcou que o evento não precisa de professores (sem isso, exige ao menos um).
  semProfessores Boolean    @default(false)
  // Aula comum (tipo AULA) cuja presença é registrada pelo professor do evento, como numa aula da grade.
  exigePresenca Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  participacoes ParticipacaoReuniao[]
  turmas        Turma[]               @relation("EventoTurmas")
  presencas     Presenca[]
}

enum StatusParticipacao {
  PENDENTE
  CONFIRMADO
  RECUSADO
}

model ParticipacaoReuniao {
  id        String             @id @default(cuid())
  reuniaoId String
  userId    String
  status    StatusParticipacao @default(PENDENTE)
  // true quando o evento foi remarcado (data ou horário) e a pessoa ainda não respondeu de novo.
  remarcado Boolean            @default(false)
  // Quando a gestão deu "ciente" da recusa (aviso na tela de início); zerado ao mudar a resposta.
  recusaCienteEm DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  reuniao Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  user    User    @relation("ParticipacoesReuniao", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, userId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  celular      String?
  passwordHash String
  roles        Role[]
  ativo        Boolean  @default(true)
  departamento String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aulas            Aula[]            @relation("ProfessorAulas")
  disponibilidades Disponibilidade[] @relation("ProfessorDisponibilidades")
  disciplinas      Disciplina[]      @relation("ProfessorDisciplinas")
  reunioesCriadas  Reuniao[]         @relation("CriadorReunioes")

  participacoesReuniao ParticipacaoReuniao[] @relation("ParticipacoesReuniao")
  ausenciasRegistradas AusenciaAula[]        @relation("AusenciasRegistradas")

  substituicoesRecebidas  Substituicao[] @relation("SubstituicoesRecebidas")
  substituicoesDesignadas Substituicao[] @relation("SubstituicoesDesignadas")

  excecoesAula AulaExcecao[] @relation("ProfessorExcecoes")

  indisponibilidadesAula IndisponibilidadeAula[] @relation("ProfessorIndisponibilidades")

  convocacoesAula ConvocacaoAula[] @relation("ProfessorConvocacoes")
  avisosProfessor AvisoProfessor[] @relation("AvisosDoProfessor")
}

model Aluno {
  id             String    @id @default(cuid())
  nome           String
  numero         String?
  email          String?   @unique
  telefone       String?
  dataNascimento DateTime? @db.Date
  cpf            String?   @unique
  endereco       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  matriculas Matricula[]
  notas      Nota[]
  presencas  Presenca[]
}

model Turma {
  id          String   @id @default(cuid())
  nome        String
  anoLetivo   Int
  turno       String?
  sala        String?
  coordenador String?
  capacidade  Int?
  gradeInicio DateTime? @db.Date
  gradeFim    DateTime? @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aulas      Aula[]
  eventos    Reuniao[] @relation("EventoTurmas")
  presencasDeEventos Presenca[]
  matriculas Matricula[]
  cargas     CargaDisciplinaTurma[]
  janelas    JanelaTurma[]

  @@unique([nome, anoLetivo])
}

model JanelaTurma {
  id            String   @id @default(cuid())
  turmaId       String
  diaSemana     String
  horarioInicio DateTime @db.Time(0)
  horarioFim    DateTime @db.Time(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, diaSemana, horarioInicio])
}

model Disciplina {
  id              String   @id @default(cuid())
  nome            String
  nomeNormalizado String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aulas       Aula[]
  professores User[]                 @relation("ProfessorDisciplinas")
  simulados   Simulado[]
  cargas      CargaDisciplinaTurma[]
  eventos     Reuniao[]  @relation("EventoDisciplina")
}

model CargaDisciplinaTurma {
  id             String     @id @default(cuid())
  turmaId        String
  disciplinaId   String
  aulasPorSemana Int
  duracaoMinutos Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  turma          Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina     Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)

  @@unique([turmaId, disciplinaId])
  @@index([disciplinaId])
}

model Disponibilidade {
  id            String   @id @default(cuid())
  professorId   String
  diaSemana     String
  horarioInicio DateTime @db.Time(0)
  horarioFim    DateTime @db.Time(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  professor User @relation("ProfessorDisponibilidades", fields: [professorId], references: [id])

  @@unique([professorId, diaSemana, horarioInicio, horarioFim])
}

model Aula {
  id            String   @id @default(cuid())
  turmaId       String
  disciplinaId  String
  professorId   String
  diaSemana     String
  horarioInicio DateTime @db.Time(0)
  horarioFim    DateTime @db.Time(0)
  sala          String?
  tipo          TipoAula @default(AULA)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  disciplina Disciplina     @relation(fields: [disciplinaId], references: [id])
  presencas  Presenca[]
  ausencias  AusenciaAula[]
  excecoes   AulaExcecao[]
  indisponibilidades IndisponibilidadeAula[]
  convocacoes ConvocacaoAula[]
  professor  User           @relation("ProfessorAulas", fields: [professorId], references: [id])
  turma      Turma          @relation(fields: [turmaId], references: [id])

  @@unique([turmaId, diaSemana, horarioInicio])
  @@unique([professorId, diaSemana, horarioInicio])
}

// Alteração de uma única ocorrência de uma Aula semanal (estilo Google Agenda). Identificada pela data original
// (o dia da série); quando não cancelada guarda um snapshot completo da ocorrência (data, horário e professor),
// de modo que editar a série depois não a altera.
model AulaExcecao {
  id            String    @id @default(cuid())
  aulaId        String
  dataOriginal  DateTime  @db.Date
  cancelada     Boolean   @default(false)
  data          DateTime? @db.Date
  horarioInicio DateTime? @db.Time(0)
  horarioFim    DateTime? @db.Time(0)
  professorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aula      Aula  @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  professor User? @relation("ProfessorExcecoes", fields: [professorId], references: [id])

  @@unique([aulaId, dataOriginal])
  @@index([data])
}

// Aviso do professor de que não conseguirá dar uma ocorrência (identificada pela data original) da aula. Não é uma
// falta: só alimenta o aviso da gestão e a cor cinza na agenda do professor. `cienteEm` = gestão deu "ciente".
model IndisponibilidadeAula {
  id           String    @id @default(cuid())
  aulaId       String
  dataOriginal DateTime  @db.Date
  professorId  String
  cienteEm     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  aula      Aula @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  professor User @relation("ProfessorIndisponibilidades", fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([aulaId, dataOriginal, professorId])
}

// Convocação do professor que a gestão colocou numa ocorrência (identificada pela data original) ao editá-la pela agenda.
// Ele responde Vou/Não vou; "Não vou" vira IndisponibilidadeAula. Só vale enquanto ele continua sendo o professor efetivo.
model ConvocacaoAula {
  id           String             @id @default(cuid())
  aulaId       String
  dataOriginal DateTime           @db.Date
  professorId  String
  status       StatusParticipacao @default(PENDENTE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  aula      Aula @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  professor User @relation("ProfessorConvocacoes", fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([aulaId, dataOriginal, professorId])
}

// Aviso informativo ao professor retirado de uma aula (RETIRADO_AULA) ou evento (RETIRADO_EVENTO). É um snapshot (a
// aula/evento pode mudar ou sumir depois) e some com o "ciente" ou quando o início passa.
model AvisoProfessor {
  id            String    @id @default(cuid())
  userId        String
  tipo          String
  titulo        String
  turma         String?
  data          DateTime  @db.Date
  horarioInicio DateTime  @db.Time(0)
  horarioFim    DateTime  @db.Time(0)
  aulaId        String?
  dataOriginal  DateTime? @db.Date
  reuniaoId     String?
  cienteEm      DateTime?
  createdAt     DateTime  @default(now())

  user User @relation("AvisosDoProfessor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Matricula {
  id            String   @id @default(cuid())
  alunoId       String
  turmaId       String
  dataMatricula DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aluno Aluno @relation(fields: [alunoId], references: [id])
  turma Turma @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, turmaId])
}

model Presenca {
  id        String   @id @default(cuid())
  alunoId   String
  // Presença de aula da grade (aulaId) OU de evento "Aula comum" com presença (reuniaoId); exatamente um dos dois.
  aulaId    String?
  reuniaoId String?
  // Turma do aluno naquele evento (os relatórios por turma); só nas presenças de evento.
  turmaId   String?
  presente  Boolean
  automatica Boolean @default(false)
  data      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aluno Aluno @relation(fields: [alunoId], references: [id])
  aula  Aula? @relation(fields: [aulaId], references: [id])
  // Restrict: evento com presença registrada não pode ser excluído (o histórico de frequência é preservado).
  reuniao Reuniao? @relation(fields: [reuniaoId], references: [id], onDelete: Restrict)
  turma Turma? @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, aulaId, data])
  @@unique([alunoId, reuniaoId])
}

model Simulado {
  id           String   @id @default(cuid())
  nome         String
  data         DateTime @db.Date
  disciplinaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  disciplina Disciplina? @relation(fields: [disciplinaId], references: [id])
  notas      Nota[]
}

model Nota {
  id          String   @id @default(cuid())
  alunoId     String
  simuladoId  String
  valor       Float
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  simulado Simulado @relation(fields: [simuladoId], references: [id])

  @@unique([alunoId, simuladoId])
}

model AusenciaAula {
  id              String   @id @default(cuid())
  aulaId          String
  data            DateTime @db.Date
  motivo          String?
  registradoPorId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aula          Aula           @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  registradoPor User           @relation("AusenciasRegistradas", fields: [registradoPorId], references: [id], onDelete: Cascade)
  substituicoes Substituicao[]

  @@unique([aulaId, data])
  @@index([data])
}

enum StatusSubstituicao {
  PENDENTE
  ACEITA
  RECUSADA
}

model Substituicao {
  id             String             @id @default(cuid())
  ausenciaId     String
  substitutoId   String
  designadoPorId String?
  status         StatusSubstituicao @default(PENDENTE)
  respondidaEm   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  ausencia     AusenciaAula @relation(fields: [ausenciaId], references: [id], onDelete: Restrict)
  substituto   User         @relation("SubstituicoesRecebidas", fields: [substitutoId], references: [id], onDelete: Cascade)
  designadoPor User?        @relation("SubstituicoesDesignadas", fields: [designadoPorId], references: [id], onDelete: SetNull)

  @@unique([ausenciaId, substitutoId])
  @@index([substitutoId, status])
}
